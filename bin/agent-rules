#!/usr/bin/env node
'use strict';

// agent-rules — vendor the shared Working rules into a project's AGENTS.md and
// refresh the CLAUDE.md / GEMINI.md pointers. Zero dependencies.

const fs = require('fs');
const path = require('path');

const CWD = process.cwd();

function die(msg) {
  console.error('agent-rules: ' + msg);
  process.exit(1);
}

const STACK_FILES = {
  rust: 'rust.md',
  ts: 'typescript-react.md',
  typescript: 'typescript-react.md',
  react: 'typescript-react.md',
  'typescript-react': 'typescript-react.md',
  godot: 'godot.md',
  gdscript: 'godot.md',
};

function readConfig() {
  const p = path.join(CWD, '.agentrules.json');
  if (!fs.existsSync(p)) {
    die('no .agentrules.json in ' + CWD +
        ' — copy templates/.agentrules.json from the agent-rules repo.');
  }
  try {
    return JSON.parse(fs.readFileSync(p, 'utf8'));
  } catch (e) {
    return die('.agentrules.json is not valid JSON: ' + e.message);
  }
}

function readRule(rulesDir, name) {
  const p = path.join(rulesDir, name);
  if (!fs.existsSync(p)) die('missing rule module: ' + p);
  return fs.readFileSync(p, 'utf8').trim();
}

function build(cfg, args) {
  const srcSpec = args.source || cfg.source ||
    die('config needs "source" (path to the agent-rules repo).');
  const source = path.resolve(CWD, srcSpec);
  const rulesDir = path.join(source, 'rules');
  if (!fs.existsSync(rulesDir)) {
    die('no rules/ under ' + source + ' — is "source" pointing at the agent-rules repo?');
  }

  const versionPath = path.join(source, 'VERSION');
  const version = fs.existsSync(versionPath)
    ? fs.readFileSync(versionPath, 'utf8').trim()
    : '0.0.0';

  const stacks = Array.isArray(cfg.stacks) ? cfg.stacks : [];
  const stackFiles = [];
  for (const s of stacks) {
    const f = STACK_FILES[String(s).toLowerCase()];
    if (!f) die('unknown stack "' + s + '" (known: rust, typescript-react, godot).');
    if (!stackFiles.includes(f)) stackFiles.push(f);
  }

  const projPath = path.join(CWD, 'AGENTS.project.md');
  if (!fs.existsSync(projPath)) {
    die('no AGENTS.project.md in ' + CWD +
        ' — this is your project-specific guide; copy templates/AGENTS.project.md to start.');
  }
  const project = fs.readFileSync(projPath, 'utf8').trim();

  const intro = readRule(rulesDir, '_intro.md');
  const order = ['core.md', 'language.md', 'commits.md', ...stackFiles, 'pull-requests.md'];
  const general = order.map((n) => readRule(rulesDir, n)).join('\n\n');

  const marker =
    '<!-- agent-rules v' + version + ' · generated by `agent-rules sync` · ' +
    'do NOT edit above the divider: change shared rules in the agent-rules repo, ' +
    "and this project's guide in AGENTS.project.md -->";

  const agents =
    '# AGENTS.md\n\n' +
    marker + '\n\n' +
    intro + '\n\n' +
    general + '\n\n' +
    '---\n\n' +
    project + '\n';

  return { agents, version };
}

const CLAUDE_MD =
  '# CLAUDE.md\n\n' +
  'The agent guide for this repository is the single source of truth in\n' +
  '**[`AGENTS.md`](AGENTS.md)**. Read it:\n\n' +
  '@AGENTS.md\n';

const GEMINI_MD =
  '# GEMINI.md\n\n' +
  'The agent guide for this repository is the single source of truth in **AGENTS.md**.\n' +
  'Read it:\n\n' +
  '@AGENTS.md\n';

function main() {
  const argv = process.argv.slice(2);
  const cmd = argv[0];
  const args = {};
  for (let i = 1; i < argv.length; i++) {
    if (argv[i] === '--check') args.check = true;
    else if (argv[i] === '--source') args.source = argv[++i];
    else die('unknown argument: ' + argv[i]);
  }

  if (cmd !== 'sync') {
    console.error('usage: agent-rules sync [--check] [--source <path-to-agent-rules>]');
    process.exit(cmd === 'help' || cmd === '--help' ? 0 : 1);
  }

  const cfg = readConfig();
  const { agents, version } = build(cfg, args);
  const target = path.join(CWD, 'AGENTS.md');

  if (args.check) {
    const current = fs.existsSync(target) ? fs.readFileSync(target, 'utf8') : '';
    if (current !== agents) {
      console.error('agent-rules: AGENTS.md is OUT OF DATE (run `agent-rules sync`).');
      process.exit(2);
    }
    console.log('agent-rules: AGENTS.md is up to date (v' + version + ').');
    return;
  }

  fs.writeFileSync(target, agents);
  fs.writeFileSync(path.join(CWD, 'CLAUDE.md'), CLAUDE_MD);
  fs.writeFileSync(path.join(CWD, 'GEMINI.md'), GEMINI_MD);
  console.log('agent-rules: wrote AGENTS.md (v' + version + '), CLAUDE.md, GEMINI.md');
}

main();
